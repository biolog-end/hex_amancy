    hexlove: {
      soulbound_ring: {
        "": "Soulbound Ring",
        owner: "Bound to %1$s",
        spouse: "Vowed to %1$s",
        awaiting_vow: "Awaiting a second vow",
        unknown: "an unknown soul",
        world_linked: "Linked to the Soul of the World",
        world_charge: "World affection: %s / %s",
      },
      chimera_spawn_egg: "Chimera Spawn Egg",
      chimera_meat: "Raw Chimera Meat",
      cooked_chimera_meat: "Cooked Chimera Meat",
      resonant_meat: "Resonant Meat",
      stew_of_serenity: "Stew of Serenity",
      stew_of_ferocity: "Stew of Ferocity",
      vow_altar: "Vow Altar",
      legendary_focus: "Legendary Focus: %s",
      crystallized_affection: {
        "": "Crystallized Affection",
        tier: {
          silence: "The world is too tired to answer today.",
          small_spark: "Simple joys matter too.",
          world_response: "Your deeds warm someone's soul.",
          forgotten_echo: "The echo of forgotten ages answers your call.",
          authors_legacy: "Legacy of the Author",
        },
        tier_message: {
          silence: {
            "1": "The world is tired, but still tried to help however it could…",
            "2": "Forgive me, traveler. This is all I can share for now.",
            "3": "You worked hard and hoped for a reward, but even the world needs rest sometimes…",
            "4": "Thank you. This little gift is all I have right now.",
            "5": "Everyone grows tired. Even the world.",
            "6": "The stones are quiet today, but one shard still heard you.",
            "7": "The answer came softly. Not every gift needs to be grand.",
            "8": "The world is saving its strength. Take this small spark for now.",
          },
          small_spark: {
            "1": "Well done!",
            "2": "Thank you. This is for you!",
            "3": "I know you hoped for something greater. But this is not so bad, is it?",
            "4": "Trust me, this will come in handy.",
            "5": "This is not all the world has prepared for you!",
            "6": "A modest gift, but given with all the world's heart.",
            "7": "May this spark help you on your journey.",
            "8": "The world noticed your efforts. Keep going.",
            "9": "Fortune is modest today, but it is still on your side.",
          },
          world_response: {
            "1": "The world heard you—and answered with something truly precious.",
            "2": "Your kindness has returned to you, strengthened by the world's echo.",
            "3": "Not every deed goes unnoticed. This one did not.",
            "4": "The heart of the world beats in time with yours.",
            "5": "Take this. You earned more than a simple spark.",
            "6": "The world remembers the warmth of your hands.",
            "7": "Today, the answer rings clear.",
            "8": "Your patience has crystallized into strength.",
            "9": "Let this gift remind you: the world knows how to answer.",
            "10": "The amethyst flared brighter. The world truly heard you.",
          },
          forgotten_echo: {
            "1": "WOW! This, this... Something cool dropped, right? I don't know Ahem,",
            "2": "The world hopes that you were given a worthy reward!",
            "3": "Next time the world will give you a reward of an even higher rank  (✿◠‿◠)",
            "4": "Hoorayyy ( •̀ ω •́ )✧ !",
            "5": "So coooool o((>ω< ))o Yes?",
            "6": "(´▽`ʃ♡ƪ)",
            "7": "Let's gooooo┗|｀O′|┛",
            "8": "⫷⨈Coolꙮ⫸",
            "9": "Open your inventory slowly. For dramatic effect.",
            "10": "This was definitely in the loot table. Probably.",
            "11": "Do not look at the world like that. It tried.",
            "12": "The echo of an old treasure room brought you a forgotten gift.",
            "13": "The world opened one of the doors that had remained locked for far too long.",
            "14": "This find remembers the hands of those whose names have long been erased.",
            "15": "Something that had been waiting specifically for you rose from the world's depths.",
            "16": "Not every treasure shines. But every one of them holds a story.",
            "17": "Today, the past decided not to remain forgotten.",
            "18": "The world preserved this thing among stone and silence.",
            "19": "May this ancient find serve a new path.",
            "20": "Chance brought your hand together with the echo of an age long gone.",
            "21": "Dungeons rarely surrender their secrets willingly.",
            "22": "You heard the call of a treasure that had been silent for far too long.",
            "23": "The world's memory took the form of a reward.",
            "24": "Sometimes an answer comes not as light, but as an item from a forgotten chest.",
            "25": "Take this carefully: even chance finds become part of history.",
            "26": "The ancient echo proved more generous than the world expected.",
            "27": "Things outlive their creators. Today, one of them found a new keeper.",
            "28": "The world did not forget this gift. It was merely waiting for the right moment.",
            "29": "The old stones parted and allowed this find to return to the light.",
            "30": "May what was lost to the past become useful to the future.",
            "31": "The treasure room is one secret emptier, and your path is richer.",
          },
        },
        quote: {
          "0": "Kindness is the one spell the world remembers without a pattern.",
          "1": "Build gently. Even stone notices the hands that place it.",
          "2": "A heart is strongest when it still has room for wonder.",
          "3": "The world answered because, for once, someone listened first.",
          "4": "What we protect becomes part of the story that protects us.",
        },
      },
      author_grimoire: {
        title: "Grimoire of the World Heart",
        section: {
          functional: "How the Spell Works",
          usage: "How to Use It",
        },
        page: {
          "1": "To %s, who taught a silent world to answer.",
          spell: "In this grimoire, the world preserved the spell “%s”. The Focus beside it already remembers its shape.",
          "2": "No pattern is written here yet. The page is warm, and waits for a future hand.",
          "3": "Keep the empty focus beside this book. One day, the missing spell may remember its shape.",
        },
      },
      legendary_spell: {
        frieren_flowers: {
          name: "Frieren Flowers",
          functional: {
            "1": "This macro iterates over an X and Z coordinate grid around the caster. For each column, it raycasts downwards to find the ground.",
            "2": "Upon hitting valid soil, it evaluates random entropy and modulo math to break specific blocks and place flora, finishing by applying Overgrow. Heavy stack management is handled via Ravenmind. If you want to learn more, make the effort yourself!",
          },
          usage: {
            "1": "Creates a large circular field of flowers around the caster! The flowers must be in the hotbar: the spell takes them from there for planting.",
            "2": "The default radius is 10 blocks. You can change the size by holding an item capable of storing a number, such as an abacus, in your off hand.",
          },
          message: "1. Congratulations! You did well, you got such a cool spell of mine. It is my favorite. Thank you for downloading my mod and playing it, it makes me incredibly happy 🥳 Tell your friends about it and all that (｡･∀･)ﾉﾞ",
        },
        excavation_protocol: {
          name: "Excavation Protocol",
          functional: {
            "1": "Extracts the caster's eye position and look vector, coercing the look vector to the nearest primary axis (X, Y, or Z). Using Thoth's Gambits, it loops through a grid relative to the axis of movement, executing Break Block.",
            "2": "Uses a Modulo operation to trigger Conjure Light exactly every 9 blocks. If you want to learn more, make the effort yourself!",
          },
          usage: {
            "1": "A very practical spell! It creates a lit 3×3 tunnel in the direction the caster is looking.",
            "2": "Its default length is 28 blocks. An item containing a number in the off hand, such as an abacus, can change its length.",
            "3": "If the spell is used while crouching, it creates a 2×1 tunnel. This saves amethyst and avoids digging too much.",
          },
          message: "2. Congratulations! I am glad that you are playing my mod. Here, take a cool spell, dig everything out here. By the way, the song is great, and the video is atmospheric, I recommend watching it during a break from the game, I hope you like it - %s . I really like it, it is a hidden gem of sorts",
        },
        math_heart_outline: {
          name: "Math Heart Outline",
          functional: {
            "1": "Evaluates parametric equations involving sine and cosine to calculate coordinates for a perfect heart outline. The scale dynamically adjusts based on the caster's height and checks whether the caster is crouching.",
            "2": "It can also read numerical input from an external Focus or Abacus. It is highly optimized for low media consumption. If you want to learn more, make the effort yourself!",
          },
          usage: {
            "1": "A beautiful spell that draws a heart from blocks in the direction you look. Its size can be customized with an item containing a number, such as an abacus.",
            "2": "When used while standing, the size is 8. When used while crouching, it is 15.",
          },
          message: "3. Congratulations! Thank you for playing with my mod, it makes me very, very happy. I hope you like it. Here, have a heart, it is beautiful, cool, you can make them huge. And, here is a very powerful song from me, not everyone may like it, but give it a chance, it is rock %1$s There is also an unusual video for one of the songs - %2$s Check it out",
        },
        math_heart_solid_core: {
          name: "Math Heart Solid Core",
          functional: {
            "1": "Uses parametric sine and cosine equations, but relies on nested Thoth's Gambits (for_each) to iterate and fill the internal volume of the shape.",
            "2": "It will rapidly drain media reserves due to the sheer volume of Place Block operations. If you want to learn more, make the effort yourself!",
          },
          usage: {
            "1": "Creates a solid block heart facing the direction you look. Its size can be changed with an item containing a number, such as an abacus.",
            "2": "Without a numerical item, the default size is 6. Keep the high cost of filling the entire volume in mind.",
          },
          message: "4. Congratulations! Thank you for playing with my mod... Have I already said this? I hope you like this spell, it creates cool little hearts! You can decorate your base, make someone happy. %s - a cool Kikuo song. In general, he has many cool songs, but I decided to send you this one, it is the most melodic. But Kikuo has very interesting, thought-provoking song lyrics, and often cool videos too. Watch it! Perhaps the world keeps more links to his songs. who knows?.. ",
        },
        omnidirectional_spatial_plane: {
          name: "Omnidirectional Spatial Plane",
          functional: {
            "1": "Reads numerical input to determine the radius (defaults to 5, but can scale up to 20 if sneaking or reading from an Abacus or Focus). It maps a 2D grid transposed into 3D space using the caster's look vector and position.",
            "2": "The macro clears intersecting blocks with Break Block and solidifies the structure with Place Block. If you want to learn more, make the effort yourself!",
          },
          usage: {
            "1": "Creates a plane of a specified size in three-dimensional space. The radius is read from an item containing a number, such as an abacus.",
            "2": "Without one, the radius is 5, making an 11×11 wall. While crouching the radius is 15, making it 31×31. Useful for landscaping and purely functional structures.",
          },
          message: "5. Congratulations! How do you like the mod? I hope you are having fun (｡･∀･)ﾉﾞ. Have fun, have fun... And yet we will inevitably die someday, this thought scares me very, very much... After death there is nothing... And there will not be... And for endless time there will be nothing.. I will not be able to think, there will no longer be a \"me\" Nothing I am doing now during my life has any meaning.., just like this mod... It is scary.. But anywaaay. A cool plane spell, I tried hard, enjoy 😎",
        },
        ethereal_sanctuary_sphere: {
          name: "Ethereal Sanctuary Sphere",
          functional: {
            "1": "Calculates a spherical volume around the caster based on the input radius. It clears the interior using Break Block and solidifies the outer shell.",
            "2": "A dedicated subroutine constructs a 3×3 floor of Conjured Blocks exactly at the caster's feet. Random entropy conditionally triggers Conjure Light along the inner surface. If you want to learn more, make the effort yourself!",
          },
          usage: {
            "1": "Creates, or more precisely excavates, a sphere with a radius set by an item containing a number, such as an abacus. The default radius is 5.",
            "2": "It creates a 3×3 platform around the caster and fully lights the sphere from within. Useful for a quick underground mini-base or decorative spheres, though expensive.",
          },
          message: "6. Congratulations! Thank you for playing with my mod, tell your friends about it. If you have suggestions - then write, I do not know whether I can post my contacts, but I am in the official Hexcasting Discord server. By the way, I wanted to share my favorite musical artist with you - %s all of his songs are masterpieces, visually too, super cool videos, with their own unique style in which you can feel a soul. And in the lyrics, which raise difficult subjects and do not require you to decipher what the author wanted to say yourself, as many do.. And I like the music too. In short, I hope you like it",
        },
        illuminated_spiral_descent: {
          name: "Illuminated Spiral Descent",
          functional: {
            "1": "Reads length from the stack. Checks the caster's height (get_entity_height) to determine vertical direction: builds upward if crouching, downward if standing. It maps an array of cardinal directional offsets, stepping the Y-axis incrementally.",
            "2": "A modulo operation (num_4, modulo) perfectly spaces Conjured Lights along the outer edge of the spiral. If you want to learn more, make the effort yourself!",
          },
          usage: {
            "1": "A practical spell that creates a lit spiral staircase downward or upward. Its length can be set with an item containing a number, such as an abacus.",
            "2": "The default path length is 30 blocks, producing a height difference of about 26 blocks. Crouching builds upward; standing builds downward.",
          },
          message: "7. Congratulations! This spell should help you conquer Minecraft. And this playlist %s will help with everything else. I use it for studying, I used it while working on this mod, while 3D modeling my course project, and simply for relaxing. It is wonderful, soft, beautiful, and outright addictive. I really hope that you like it (*^▽^*). Enjoy the game! I hope you are having fun, have a good day, week, month, year, and in general, I hope that your whole life will be good, and turn out in the best possible way!",
        },
        blueprint_architect: {
          name: "Blueprint Architect (Maker)",
          functional: {
            "1": "Requires a Focus initialized with Null. When casting on a block, it calculates the block's offset relative to the caster's starting anchor coordinate and look vector. This ensures the blueprint is independent of world coordinates.",
            "2": "It prevents recording duplicate blocks, checks out-of-bounds ambit limits, and uses Make Note to provide distinct audio feedback upon success or error. If you want to learn more, make the effort yourself!",
          },
          usage: {
            "1": "A very complex spell that creates blueprints for Blueprint Foreman (Builder). First, take a separate Focus and write Null into it.",
            "2": "Stand on the anchor point where the blueprint will begin and cast this spell on the block beneath you. Then cast it on every block you want to include.",
            "3": "You cannot record the same block twice. Different sounds report additions and errors. Blocks farther than 32 blocks from the anchor cannot be added, or construction would exceed the ambit.",
            "4": "The spell cannot distinguish block types. Each material needs a separate blueprint made from the same anchor point.",
          },
          message: "8. Congratulations! I hope you find (or create yourself) the Blueprint Foreman (Builder) spell for building houses from your blueprints! Have a good day, I am glad that you are playing my love mod. And what is love? It is cool, cute, fun. And cute means cats, so here is a song about cats for you ^^ %s . Thank you for playing my mod, I appreciate it very much ヾ(≧▽≦*)o",
        },
        blueprint_foreman: {
          name: "Blueprint Foreman (Builder)",
          functional: {
            "1": "Reads the coordinate array saved by the Architect. If the caster is sneaking (get_entity_height < 1.6), it intercepts the build process and prints the total number of blocks required for the structure.",
            "2": "Otherwise, it uses arctan2, sine, and cosine to rotate the blueprint's relative coordinates to match the caster's look vector, placing blocks via Place Block. Multi-material structures require separate blueprints. If you want to learn more, make the effort yourself!",
          },
          usage: {
            "1": "Builds a structure from a blueprint created by Blueprint Architect (Maker). A completed blueprint is required.",
            "2": "Hold the Focus containing the blueprint and use the spell. While crouching, it reports the number of blocks needed instead of building.",
          },
          message: "9. Congratulations! Thank you for playing my mod! And if you are also reading this text.. I am really happy. For this spell you need to have the \"Blueprint Architect (Maker)\" spell, or create it, I hope you will be able to do that.  %s here is a cool cute song to listen to. Good luck ^^",
        },
        elytra_catalyst: {
          name: "Elytra Catalyst",
          functional: {
            "1": "Checks the caster's entity height. If the caster is standing normally (height > 1), it assumes they are grounded and invokes Altiora to deploy magical wings.",
            "2": "If crouching or already gliding (height < 1), it extracts the look vector, multiplies its magnitude, and applies Impulse for a massive burst of speed. If you want to learn more, make the effort yourself!",
          },
          usage: {
            "1": "A simple but useful spell. When used on the ground, it equips the player with magical elytra and throws them into the air.",
            "2": "When used in the air, it accelerates the player forward like a firework.",
          },
          message: "10. Congratulations! Here, take a useful spell. Thank you for playing my mod. Here is a cool song, cool-sounding and cool-looking %s , probably the best animation I have ever seen in my life. Well, good luck to you, traveler. may luck always be on your side. Have fun, do not be sad, and do not overwork yourself. See you! I am @tteka_s",
        },
      },
    },
  },

